# Copy to `.env` at repo root. PostgreSQL is external — not bundled in Compose.

# Required: connection string to your existing Postgres (host must be reachable from the api container)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_DB_HOST:5432/twentynine_homestay

WEB_PORT=8080
API_PORT_FORWARD=4001
APP_ORIGIN=http://localhost:8080
# Every browser origin that calls the API (comma-separated, no spaces). Add your public domain or CORS will block login.
# Example: APP_ORIGINS=http://160.191.50.161:8080,http://localhost:8080,http://29digital.locole.io.vn,https://29digital.locole.io.vn
APP_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api/v1

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
COOKIE_NAME=twentynine_admin_token
COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=5

SEED_ADMIN_EMAIL=admin@twentyninehomestay.local
SEED_ADMIN_PASSWORD=ChangeMe123!

RUN_DB_PUSH=true
RUN_DB_SEED=true
